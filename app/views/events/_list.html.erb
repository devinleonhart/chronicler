<div class="bb-card overflow-x-auto">
  <table class="bb-table">
    <thead>
      <tr>
        <% { "name" => "Event", "start_date" => "Start Date", "end_date" => "End Date" }.each do |column, label| %>
          <% sorted = @listing.sort == column %>
          <% order = @listing.direction == "asc" ? "ascending" : "descending" %>
          <%= tag.th(class: "whitespace-nowrap", aria: { sort: (order if sorted) }) do %>
            <%= link_to label, events_path(@listing.sort_params(column)), class: "hover:underline",
                        data: { turbo_frame: "results", turbo_action: "replace" } %>
            <% if sorted %><span aria-hidden="true"><%= order == "ascending" ? "▲" : "▼" %></span><% end %>
          <% end %>
        <% end %>
        <th>Characters &amp; Ages</th>
        <th><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% @listing.rows.each do |row| %>
        <% if row.is_a?(EventListing::Life) %>
          <tr class="italic text-neutral-600">
            <td><%= row.name %></td>
            <td class="whitespace-nowrap"><%= row.start_date %></td>
            <td>—</td>
            <td></td>
            <td></td>
          </tr>
        <% else %>
          <tr class="<%= "bg-neutral-100" if row.is_current_day %>">
            <td class="font-medium"><%= row.name %></td>
            <td class="bb-subtitle whitespace-nowrap"><%= row.start_date %></td>
            <td class="bb-subtitle whitespace-nowrap"><%= row.end_date || "—" %></td>
            <td>
              <% if row.is_current_day %>
                <%= link_to "View all ages", current_day_path, class: "bb-link" %>
              <% elsif row.characters.empty? %>
                <span class="bb-subtitle">—</span>
              <% else %>
                <ul>
                  <% row.characters.sort_by(&:name).each do |character| %>
                    <li>
                      <% if character.death_date && character.death_date <= row.start_date %>
                        <s><%= character.name %></s>
                      <% else %>
                        <span><%= character.name %></span>
                      <% end %>
                      <span class="bb-subtitle-sm">age <%= event_ages(row, character) %></span>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            </td>
            <td>
              <div class="flex justify-end gap-4">
                <%= link_to "Edit", edit_event_path(row), data: { turbo_frame: "dialog" }, class: "bb-link", aria: { label: "Edit #{row.name}" } %>
                <% unless row.is_current_day %>
                  <%= delete_button "Delete #{row.name}", event_path(row), title: "Delete Event", message: "Are you sure you want to delete this event?" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
