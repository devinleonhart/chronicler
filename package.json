{
  "name": "chronicler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0",
    "pnpm": ">=12.8.1"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "test:server": "vitest run",
    "test:server:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "tsc": "nuxt typecheck",
    "quality": "pnpm run test && pnpm run lint && pnpm run tsc",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx server/db/seed.ts",
    "db:merge-characters": "tsx server/db/mergeCharacters.ts",
    "mcp": "tsx mcp/server.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.49.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@pinia/nuxt": "^1.0.2",
    "axios": "^1.20.0",
    "drizzle-orm": "^0.45.3",
    "nuxt": "^4.5.2",
    "pg": "^8.23.1",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.5",
    "tsx": "^4.23.15",
    "uuid": "^14.0.2",
    "vis-data": "^8.0.5",
    "vis-timeline": "^8.5.4",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/vis": "^4.21.27",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "~0.28.2",
    "eslint": "~10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "h3": "^1.15.11",
    "supertest": "~7.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue-tsc": "~3.3.11"
  }
}
