<%# locals: (title:, entries:) -%>
<section class="mb-8">
  <h2 class="bb-section-heading--sm"><%= title %></h2>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
    <% entries.each do |entry| %>
      <%= link_to edit_character_path(entry.character), data: { turbo_frame: "dialog" },
                  class: class_names("bb-card px-4 py-3 flex justify-between gap-3 hover:bg-neutral-100", "opacity-60" => entry.deceased) do %>
        <span class="font-medium"><%= entry.character.name %></span>
        <span class="bb-subtitle whitespace-nowrap"><%= entry.age_text %></span>
      <% end %>
    <% end %>
  </div>
</section>
